rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow authenticated users to upload and read purchase order PDFs
    match /purchase-orders/{fileName} {
      allow read: if true; // Public read for suppliers to download
      allow write: if request.auth != null; // Only authenticated users can upload
    }
    
    // Default: deny all other access
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
